# Copy to .env.local and adjust. Only VITE_* variables reach the browser bundle; these two are dev server settings.

# Backend the dev server proxies /api to (default: the dev backend). A local backend: http://localhost:9091
# API_PROXY_TARGET=https://api-dev-narrativ.rizkysiregar.my.id

# Dev server port (default 3000)
# DEV_PORT=3000

# OpenAPI document for npm run api:generate (default: the dev backend)
# OPENAPI_URL=http://localhost:9091/api/v1/v3/api-docs
